# Copy to .env.local and fill in. See GUIDE.md for where each value comes from.
# .env.local is gitignored.

# --- Database (Neon) ---------------------------------------------------------
# Neon → your project → Connection Details → "Pooled connection" string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me"
# Public origin of the app. In local dev this is fine as-is.
AUTH_URL="http://localhost:3000"

# --- Email (magic links) -------------------------------------------------
# Leave EMAIL_SERVER_HOST unset in local dev — sign-in links print to the
# server console instead. Fill these to send real mail (Resend SMTP shown).
# EMAIL_SERVER_HOST="smtp.resend.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="resend"
# EMAIL_SERVER_PASSWORD="re_xxxxxxxx"
# EMAIL_FROM="Storefront Desk <login@yourdomain.com>"

# --- Product ---------------------------------------------------------------
APP_NAME="Storefront Desk"

# --- Object storage (product photos, S3-compatible) ----------------------
# Default: Supabase Storage (free, no card). See GUIDE.md step 4a.
# Leave unset and photo upload is hidden; products still save without photos.
# STORAGE_ENDPOINT="https://xxxxxxxx.supabase.co/storage/v1/s3"
# STORAGE_REGION="us-east-1"
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
# STORAGE_BUCKET="product-photos"
# STORAGE_PUBLIC_BASE_URL="https://xxxxxxxx.supabase.co/storage/v1/object/public/product-photos"

# --- Restricted runtime DB role (RLS enforcement) -----------------------
# After running `RUNTIME_DB_PASSWORD=... npm run db:rls`, paste the printed
# connection string here. The app's tenant-scoped writes run as this
# NOBYPASSRLS role so Postgres RLS is actually enforced, not just latent.
# Falls back to DATABASE_URL when unset. See GUIDE.md step 5.
# DATABASE_URL_RUNTIME="postgresql://app_runtime:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
