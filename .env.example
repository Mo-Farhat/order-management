# Copy to .env.local and fill in. See GUIDE.md for where each value comes from.
# .env.local is gitignored.

# --- Database (Neon) ---------------------------------------------------------
# Neon → your project → Connection Details → "Pooled connection" string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me"
# Public origin of the app. In local dev this is fine as-is.
AUTH_URL="http://localhost:3000"

# --- Email (Resend HTTP API) -------------------------------------------
# Transactional mail (password resets). Unset → the email body is logged to
# the server console so the flow still works in dev. See GUIDE.md step 3.
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Storefront Desk <login@yourdomain.com>"   # verified domain, or omit to use onboarding@resend.dev

# --- Product ---------------------------------------------------------------
APP_NAME="Storefront Desk"

# --- Platform admin -------------------------------------------------------
# Comma-separated emails that can see /admin (cross-tenant operator view).
# ADMIN_EMAILS="you@example.com"

# --- Object storage (product photos, S3-compatible) — Cloudflare R2 -------
# See GUIDE.md step 4a. Leave unset and photo upload is hidden; products
# still save without photos.
# STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# STORAGE_REGION="auto"
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
# STORAGE_BUCKET="storefront-desk-media"
# STORAGE_PUBLIC_BASE_URL="https://media.<yourdomain>"   # R2 public bucket URL or custom domain

# --- Restricted runtime DB role (RLS enforcement) -----------------------
# After running `RUNTIME_DB_PASSWORD=... npm run db:rls`, paste the printed
# connection string here. The app's tenant-scoped writes run as this
# NOBYPASSRLS role so Postgres RLS is actually enforced, not just latent.
# Falls back to DATABASE_URL when unset. See GUIDE.md step 5.
# DATABASE_URL_RUNTIME="postgresql://app_runtime:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
