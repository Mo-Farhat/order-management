{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storefront-desk",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Next.js cache backing store (see open-next.config.ts). Both must exist
  // before the first deploy — GUIDE.md step 4c has the two wrangler commands.
  // These are separate from the product-photo bucket, which the app reaches
  // over the S3 API using the STORAGE_* secrets, not a binding.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "sfdesk-next-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "sfdesk-next-tags",
      "database_id": "7a9351d1-57ce-47f9-abaa-b7a63dc4df30"
    }
  ],

  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put NAME`, not here):
  //   DATABASE_URL, DATABASE_URL_RUNTIME, AUTH_SECRET,
  //   EMAIL_SERVER_HOST, EMAIL_SERVER_PORT, EMAIL_SERVER_USER,
  //   EMAIL_SERVER_PASSWORD, EMAIL_FROM,
  //   STORAGE_ENDPOINT, STORAGE_REGION, STORAGE_ACCESS_KEY_ID,
  //   STORAGE_SECRET_ACCESS_KEY, STORAGE_BUCKET, STORAGE_PUBLIC_BASE_URL
  // Plain vars (safe to commit) go in "vars": { ... } — e.g. APP_NAME, AUTH_URL.
}
